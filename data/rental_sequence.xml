<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rental_application" model="ir.sequence">
        <field name="name">Rental Application</field>
        <field name="code">rental.application</field>
        <field name="prefix">APP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rental_contract" model="ir.sequence">
        <field name="name">Rental Contract</field>
        <field name="code">rental.contract</field>
        <field name="prefix">RENT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rental_notice" model="ir.sequence">
        <field name="name">Tenant Rental Notice</field>
        <field name="code">rental.notice</field>
        <field name="prefix">NOTICE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
