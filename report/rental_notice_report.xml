<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rental_notice" model="ir.actions.report">
        <field name="name">Tenant Notice</field>
        <field name="model">rental.notice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">apartment_rental_management.report_rental_notice_document</field>
        <field name="report_file">apartment_rental_management.report_rental_notice_document</field>
        <field name="print_report_name">'Tenant Notice - %s' % object.name</field>
        <field name="binding_model_id" ref="model_rental_notice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_rental_notice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2><span t-field="o.notice_type"/></h2>
                            <h4 t-field="o.name"/>
                        </div>
                        <table class="table table-sm table-bordered mb-4">
                            <tbody>
                                <tr><th>Notice date</th><td><span t-field="o.notice_date"/></td></tr>
                                <tr><th>Tenant</th><td><span t-field="o.partner_id"/></td></tr>
                                <tr><th>Tenant address</th><td><span t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/></td></tr>
                                <tr><th>Rental contract</th><td><span t-field="o.contract_id"/></td></tr>
                                <tr><th>Premises</th><td><span t-field="o.unit_id"/> — <span t-field="o.contract_id.property_id"/></td></tr>
                                <tr><th>Ground</th><td><span t-field="o.ground"/></td></tr>
                                <tr t-if="o.amount_due"><th>Outstanding rent</th><td><span t-field="o.amount_due"/></td></tr>
                                <tr t-if="o.response_deadline"><th>Response / cure deadline</th><td><span t-field="o.response_deadline"/></td></tr>
                            </tbody>
                        </table>
                        <h3 t-field="o.subject"/>
                        <div t-field="o.body_html" class="mt-3"/>
                        <div class="mt-5" style="page-break-inside: avoid;">
                            <p><strong t-field="o.company_id.name"/></p>
                            <p t-if="o.issued_by_id">Issued by <span t-field="o.issued_by_id.name"/> on <span t-field="o.issued_on"/></p>
                        </div>
                        <div class="mt-4 text-muted" style="font-size: 9px;" t-if="o.document_hash">
                            Archived document hash: <span t-field="o.document_hash"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
