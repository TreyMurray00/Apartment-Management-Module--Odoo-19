<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_charge_list" model="ir.ui.view">
        <field name="name">rental.charge.list</field>
        <field name="model">rental.charge</field>
        <field name="arch" type="xml">
            <list string="Tenant Charges" decoration-muted="state == 'cancelled'" decoration-success="state == 'invoiced'">
                <field name="invoice_date"/>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="calculation_type" optional="hide"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
                <field name="move_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_create_invoice" string="Invoice" type="object" icon="fa-file-text-o" invisible="state != 'pending'" groups="apartment_rental_management.group_rental_manager"/>
            </list>
        </field>
    </record>

    <record id="view_rental_charge_form" model="ir.ui.view">
        <field name="name">rental.charge.form</field>
        <field name="model">rental.charge</field>
        <field name="arch" type="xml">
            <form string="Tenant Charge">
                <header>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state != 'pending'" groups="apartment_rental_management.group_rental_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'pending'" groups="apartment_rental_management.group_rental_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,invoiced,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="state != 'pending'"/></h1></div>
                    <group>
                        <group string="Liability">
                            <field name="contract_id" readonly="state != 'pending'" options="{'no_create': True}"/>
                            <field name="category" readonly="state != 'pending'"/>
                            <field name="product_id" readonly="state != 'pending'"/>
                            <field name="service_date" readonly="state != 'pending'"/>
                            <field name="invoice_date" readonly="state != 'pending'"/>
                        </group>
                        <group string="Calculation">
                            <field name="currency_id" invisible="1"/>
                            <field name="calculation_type" readonly="state != 'pending'"/>
                            <field name="units" invisible="calculation_type != 'quantity'" readonly="state != 'pending'"/>
                            <field name="meter_previous" invisible="calculation_type != 'meter'" readonly="state != 'pending'"/>
                            <field name="meter_current" invisible="calculation_type != 'meter'" readonly="state != 'pending'"/>
                            <field name="quantity" readonly="1"/>
                            <field name="unit_price" readonly="state != 'pending'"/>
                            <field name="amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="move_id" readonly="1" invisible="not move_id"/>
                        <field name="source_invoice_id" readonly="1" invisible="not source_invoice_id"/>
                        <field name="notes" readonly="state != 'pending'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_charge_search" model="ir.ui.view">
        <field name="name">rental.charge.search</field>
        <field name="model">rental.charge</field>
        <field name="arch" type="xml">
            <search string="Tenant Charges">
                <field name="name"/><field name="contract_id"/><field name="category"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Utilities" name="utilities" domain="[('category', 'in', ('electricity', 'water', 'gas', 'internet', 'waste', 'utility_other'))]"/>
                <filter string="Late Fees" name="late_fees" domain="[('category', '=', 'late_fee')]"/>
                <separator/>
                <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rental_charge" model="ir.actions.act_window">
        <field name="name">Tenant Charges</field>
        <field name="res_model">rental.charge</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_charge_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
