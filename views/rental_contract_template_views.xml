<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_contract_template_list" model="ir.ui.view">
        <field name="name">rental.contract.template.list</field>
        <field name="model">rental.contract.template</field>
        <field name="arch" type="xml">
            <list string="Contract Templates" decoration-muted="not active">
                <field name="name"/>
                <field name="version"/>
                <field name="rental_type"/>
                <field name="billing_frequency"/>
                <field name="effective_date" optional="show"/>
                <field name="expiration_date" optional="show"/>
                <field name="require_manager_signature" optional="show"/>
                <field name="source_document_filename" string="Uploaded Master" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_template_form" model="ir.ui.view">
        <field name="name">rental.contract.template.form</field>
        <field name="model">rental.contract.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <header>
                    <button name="action_new_revision" string="Create New Revision" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard Long-Term Lease"/></h1>
                    </div>
                    <group>
                        <group string="Template">
                            <field name="version"/>
                            <field name="rental_type"/>
                            <field name="billing_frequency"/>
                            <field name="invoice_lead_days"/>
                            <field name="require_manager_signature"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Validity">
                            <field name="effective_date"/>
                            <field name="expiration_date"/>
                        </group>
                    </group>
                    <group string="Default Late Fee Policy">
                        <group>
                            <field name="late_fee_enabled"/>
                            <field name="late_fee_calculation" invisible="not late_fee_enabled"/>
                            <field name="late_fee_grace_days" invisible="not late_fee_enabled"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="late_fee_amount" invisible="not late_fee_enabled or late_fee_calculation != 'fixed'"/>
                            <field name="late_fee_percentage" invisible="not late_fee_enabled or late_fee_calculation != 'percent'"/>
                            <field name="late_fee_product_id" invisible="not late_fee_enabled"/>
                        </group>
                    </group>
                    <group string="Default Tenant Notice Policy">
                        <group>
                            <field name="payment_notice_grace_days"/>
                            <field name="eviction_nonpayment_threshold"/>
                            <field name="auto_prepare_late_notices"/>
                        </group>
                        <group>
                            <field name="late_notice_template_id" options="{'no_create': True}"/>
                            <field name="eviction_notice_template_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Body">
                            <div class="alert alert-info" role="alert">
                                This editable body is copied into each draft contract. It becomes an independent snapshot, so future template revisions do not alter contracts already created.
                            </div>
                            <field name="terms" placeholder="Enter the reusable legal clauses and agreement text..."/>
                        </page>
                        <page string="Uploaded Master">
                            <div class="alert alert-warning" role="alert">
                                Upload a PDF, DOCX, or ODT as the legal master/reference. Odoo does not merge text from this file automatically; paste the mergeable wording into the Contract Body tab for the signed PDF.
                            </div>
                            <field name="source_document_filename" invisible="1"/>
                            <field name="source_document" filename="source_document_filename"/>
                        </page>
                        <page string="Internal Notes"><field name="internal_notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_contract_template_search" model="ir.ui.view">
        <field name="name">rental.contract.template.search</field>
        <field name="model">rental.contract.template</field>
        <field name="arch" type="xml">
            <search string="Contract Templates">
                <field name="name"/>
                <field name="version"/>
                <filter string="Short Term" name="short" domain="[('rental_type', '=', 'short')]"/>
                <filter string="Long Term" name="long" domain="[('rental_type', '=', 'long')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Rental Type" name="group_type" context="{'group_by': 'rental_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_rental_contract_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">rental.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_contract_template_search"/>
    </record>
</odoo>
