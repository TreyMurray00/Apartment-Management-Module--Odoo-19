<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_unit_list" model="ir.ui.view">
        <field name="name">rental.unit.list</field>
        <field name="model">rental.unit</field>
        <field name="arch" type="xml">
            <list string="Rental Units" decoration-muted="not active">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_type"/>
                <field name="bedrooms"/>
                <field name="furnished"/>
                <field name="short_term_rate" optional="show"/>
                <field name="long_term_rate" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="occupancy_state" widget="badge" decoration-success="occupancy_state == 'available'" decoration-danger="occupancy_state == 'occupied'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rental_unit_form" model="ir.ui.view">
        <field name="name">rental.unit.form</field>
        <field name="model">rental.unit</field>
        <field name="arch" type="xml">
            <form string="Rental Unit">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_text">Contracts</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Occupied" bg_color="text-bg-danger" invisible="occupancy_state != 'occupied'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Apartment 4B"/></h1>
                    </div>
                    <group>
                        <group string="Unit">
                            <field name="property_id"/>
                            <field name="unit_type"/>
                            <field name="floor"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="area"/>
                            <field name="furnished"/>
                            <field name="current_contract_id" readonly="1" invisible="not current_contract_id"/>
                        </group>
                        <group string="Rental Pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="short_term_rate"/>
                            <field name="long_term_rate"/>
                            <field name="deposit_amount"/>
                            <field name="rent_product_id" required="1"/>
                            <field name="deposit_product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amenities &amp; Notes"><field name="amenity_notes"/></page>
                        <page string="Contract History">
                            <field name="contract_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="rental_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_unit_search" model="ir.ui.view">
        <field name="name">rental.unit.search</field>
        <field name="model">rental.unit</field>
        <field name="arch" type="xml">
            <search string="Rental Units">
                <field name="name"/>
                <field name="property_id"/>
                <filter string="Available" name="available" domain="[('occupancy_state', '=', 'available')]"/>
                <filter string="Occupied" name="occupied" domain="[('occupancy_state', '=', 'occupied')]"/>
                <filter string="Short-term Enabled" name="short_enabled" domain="[('short_term_rate', '&gt;', 0)]"/>
                <filter string="Long-term Enabled" name="long_enabled" domain="[('long_term_rate', '&gt;', 0)]"/>
                <separator/>
                <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'unit_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_rental_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">rental.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_unit_search"/>
    </record>
</odoo>
